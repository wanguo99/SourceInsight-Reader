{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 Source Insight Inspired",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/examples/cpp"]
    },
    {
      "name": "扩展宿主集成测试",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--extensionTestsPath=${workspaceFolder}/test/host", "${workspaceFolder}/examples/cpp"]
    }
  ]
}
