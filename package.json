                  "minimum": 6,
                  "maximum": 100
                },
                "foreground": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                },
                "background": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                }
              }
            },
            "files": {
              "type": "object",
