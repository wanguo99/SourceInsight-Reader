{
  "name": "source-reader",
  "displayName": "Source Reader",
  "description": "Source Insight 风格的符号、定义、调用关系和引用阅读工作台。",
  "version": "0.6.0",
  "publisher": "local-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "check": "node scripts/check.js && tsc -p jsconfig.json",
    "test": "node scripts/test.js",
    "package": "node scripts/package.js",
    "test:host": "node test/run-host.js",
    "test:unit": "node scripts/test.js unit",
    "test:clangd": "node scripts/test.js clangd",
    "vscode:prepublish": "npm run check"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "sourceReaderPanel",
          "title": "Source Reader",
          "icon": "media/book.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "sourceReader",
          "title": "Source Reader 文件符号",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "sourceReader": [
        {
          "id": "sourceReader.symbols",
          "name": "文件符号"
        }
      ],
      "sourceReaderPanel": [
        {
          "id": "sourceReader.context",
          "name": "Context",
          "type": "webview"
        },
        {
          "id": "sourceReader.relations",
          "name": "Relation"
        }
      ]
    },
    "commands": [
      {
        "command": "sourceReader.open",
        "title": "Source Reader: 打开阅读工作台"
      },
      {
        "command": "sourceReader.filterSymbols",
        "title": "筛选文件符号",
        "icon": "$(filter)"
      },
      {
        "command": "sourceReader.sortSymbols",
        "title": "切换函数排序",
        "icon": "$(list-ordered)"
      },
      {
        "command": "sourceReader.refreshSymbols",
        "title": "刷新函数列表",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceReader.previewDefinition",
        "title": "Source Reader: 预览定义"
      },
      {
        "command": "sourceReader.previewType",
        "title": "Source Reader: 预览类型定义"
      },
      {
        "command": "sourceReader.previewFile",
        "title": "在 Context 预览文件"
      },
      {
        "command": "sourceReader.openTarget",
        "title": "在主编辑器打开",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceReader.toggleContextLock",
        "title": "锁定/解锁 Context",
        "icon": "$(lock)"
      },
      {
        "command": "sourceReader.refreshContext",
        "title": "刷新 Context",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceReader.incoming",
        "title": "Source Reader: 谁调用它",
        "icon": "$(call-incoming)"
      },
      {
        "command": "sourceReader.outgoing",
        "title": "Source Reader: 它调用谁",
        "icon": "$(call-outgoing)"
      },
      {
        "command": "sourceReader.setRoot",
        "title": "设为 Relation 根节点"
      },
      {
        "command": "sourceReader.toggleRelationLock",
        "title": "锁定/解锁 Relation",
        "icon": "$(lock)"
      },
      {
        "command": "sourceReader.refreshRelations",
        "title": "刷新 Relation",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceReader.lookupReferences",
        "title": "Source Reader: Lookup References",
        "icon": "$(references)"
      },
      {
        "command": "sourceReader.refreshReferences",
        "title": "刷新引用",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceReader.clearReferences",
        "title": "清除引用",
        "icon": "$(clear-all)"
      },
      {
        "command": "sourceReader.back",
        "title": "Source Reader: 阅读位置后退"
      },
      {
        "command": "sourceReader.forward",
        "title": "Source Reader: 阅读位置前进"
      },
      {
        "command": "sourceReader.findFile",
        "title": "Source Reader: 查找工程文件",
        "icon": "$(search)"
      },
      {
        "command": "sourceReader.browseSymbols",
        "title": "Source Reader: 查找全局符号",
        "icon": "$(symbol-method)"
      },
      {
        "command": "sourceReader.jumpToDefinition",
        "title": "Source Reader: 跳转到定义",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceReader.openSelection",
        "title": "Source Reader: 打开选中位置",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceReader.contextMode",
        "title": "Context 跟随模式",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sourceReader.filterReferences",
        "title": "筛选引用",
        "icon": "$(filter)"
      },
      {
        "command": "sourceReader.referenceHistory",
        "title": "引用查询历史",
        "icon": "$(history)"
      },
      {
        "command": "sourceReader.nextReference",
        "title": "Source Reader: 下一个引用",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sourceReader.previousReference",
        "title": "Source Reader: 上一个引用",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sourceReader.toggleSymbolKinds",
        "title": "切换全部符号/仅函数",
        "icon": "$(symbol-class)"
      },
      {
        "command": "sourceReader.focusSymbols",
        "title": "Source Reader: 聚焦文件符号"
      },
      {
        "command": "sourceReader.focusContext",
        "title": "Source Reader: 聚焦 Context"
      },
      {
        "command": "sourceReader.focusRelations",
        "title": "Source Reader: 聚焦 Relation"
      },
      {
        "command": "sourceReader.focusReferences",
        "title": "Source Reader: 聚焦引用结果"
      },
      {
        "command": "sourceReader.chooseAppearance",
        "title": "Source Reader: 选择阅读主题",
        "icon": "$(color-mode)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sourceReader.filterSymbols",
          "when": "view == sourceReader.symbols",
          "group": "navigation"
        },
        {
          "command": "sourceReader.sortSymbols",
          "when": "view == sourceReader.symbols"
        },
        {
          "command": "sourceReader.refreshSymbols",
          "when": "view == sourceReader.symbols",
          "group": "navigation"
        },
        {
          "command": "sourceReader.incoming",
          "when": "view == sourceReader.relations",
          "group": "navigation"
        },
        {
          "command": "sourceReader.outgoing",
          "when": "view == sourceReader.relations",
          "group": "navigation"
        },
        {
          "command": "sourceReader.toggleRelationLock",
          "when": "view == sourceReader.relations",
          "group": "navigation"
        },
        {
          "command": "sourceReader.refreshRelations",
          "when": "view == sourceReader.relations",
          "group": "navigation"
        },
        {
          "command": "sourceReader.toggleContextLock",
          "when": "view == sourceReader.context",
          "group": "navigation"
        },
        {
          "command": "sourceReader.refreshContext",
          "when": "view == sourceReader.context",
          "group": "navigation"
        },
        {
          "command": "sourceReader.browseSymbols",
          "when": "view == sourceReader.symbols",
          "group": "navigation"
        },
        {
          "command": "sourceReader.toggleSymbolKinds",
          "when": "view == sourceReader.symbols",
          "group": "navigation"
        },
        {
          "command": "sourceReader.contextMode",
          "when": "view == sourceReader.context",
          "group": "navigation"
        },
        {
          "command": "sourceReader.chooseAppearance",
          "when": "view == sourceReader.symbols || view == sourceReader.context",
          "group": "navigation@99"
        }
      ],
      "view/item/context": [
        {
          "command": "sourceReader.lookupReferences",
          "when": "viewItem == sourceReader.symbol || viewItem == sourceReader.relation"
        },
        {
          "command": "sourceReader.setRoot",
          "when": "viewItem == sourceReader.symbol || viewItem == sourceReader.relation"
        },
        {
          "command": "sourceReader.openTarget",
          "when": "viewItem == sourceReader.relation || viewItem == sourceReader.reference || viewItem == sourceReader.callsite"
        }
      ],
      "editor/context": [
        {
          "command": "sourceReader.jumpToDefinition",
          "group": "navigation@19"
        },
        {
          "command": "sourceReader.previewDefinition",
          "group": "navigation@20"
        },
        {
          "command": "sourceReader.lookupReferences",
          "group": "navigation@21"
        },
        {
          "command": "sourceReader.setRoot",
          "group": "navigation@22"
        }
      ]
    },
    "configuration": {
      "title": "Source Reader",
      "properties": {
        "sourceReader.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "光标停留时自动在 Context 预览定义。"
        },
        "sourceReader.autoRelation": {
          "type": "boolean",
          "default": true,
          "description": "未锁定时 Relation 跟随当前函数。"
        },
        "sourceReader.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 100,
          "maximum": 2000,
          "description": "自动查询防抖时间（毫秒）。"
        },
        "sourceReader.contextLines": {
          "type": "integer",
          "default": 20,
          "minimum": 5,
          "maximum": 100,
          "description": "Context 目标上下显示的行数。"
        },
        "sourceReader.files.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git",
            "**/node_modules"
          ],
          "description": "工程文件查找的额外排除 glob；支持 *、?、**，遵循 files.exclude。"
        },
        "sourceReader.files.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "工程文件查找的包含 glob，空数组显示全部。"
        },
        "sourceReader.symbolSort": {
          "type": "string",
          "enum": [
            "position",
            "name"
          ],
          "default": "position",
          "description": "函数列表排序方式。"
        },
        "sourceReader.sourceInsightKeys": {
          "type": "boolean",
          "default": true,
          "description": "启用 Source Insight 风格的 Alt+=、Alt+,、Alt+.，并将 Shift+F12 路由至编辑区引用结果页；F8 浏览已查询引用。可关闭以恢复 VS Code 默认键位。"
        },
        "sourceReader.contextMode": {
          "type": "string",
          "enum": [
            "definition",
            "type",
            "enclosing"
          ],
          "default": "definition",
          "description": "Context 智能跟随：函数、标量变量和数组查看定义，结构体/类/枚举对象可预览类型；也可强制类型定义或包含函数。"
        },
        "sourceReader.symbolKinds": {
          "type": "string",
          "enum": [
            "functions",
            "all"
          ],
          "default": "all",
          "description": "默认显示文件全部符号，包括 C/C++ 头文件包含、宏、全局变量、结构体、枚举和函数。functions 仅显示函数及其容器。"
        },
        "sourceReader.appearance": {
          "type": "string",
          "enum": [
            "vscode",
            "sourceInsight"
          ],
          "default": "vscode",
          "scope": "window",
          "enumDescriptions": [
            "保留当前 VS Code 主题；从 Source Insight 切回时恢复原主题设置。",
            "应用插件内置的 Source Insight XML 配色主题。"
          ],
          "description": "选择 VS Code 当前主题或内置 Source Insight 自定义主题。"
        }
      }
    },
    "keybindings": [
      {
        "command": "sourceReader.jumpToDefinition",
        "key": "alt+=",
        "when": "config.sourceReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceReader.back",
        "key": "alt+,",
        "when": "config.sourceReader.sourceInsightKeys && (editorTextFocus || listFocus)"
      },
      {
        "command": "sourceReader.forward",
        "key": "alt+.",
        "when": "config.sourceReader.sourceInsightKeys && (editorTextFocus || listFocus)"
      },
      {
        "command": "sourceReader.lookupReferences",
        "key": "shift+f12",
        "when": "config.sourceReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceReader.browseSymbols",
        "key": "alt+shift+s",
        "when": "config.sourceReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceReader.findFile",
        "key": "alt+shift+p",
        "when": "config.sourceReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceReader.nextReference",
        "key": "f8",
        "when": "config.sourceReader.sourceInsightKeys && sourceReader.hasReferences && editorTextFocus"
      },
      {
        "command": "sourceReader.previousReference",
        "key": "shift+f8",
        "when": "config.sourceReader.sourceInsightKeys && sourceReader.hasReferences && editorTextFocus"
      },
      {
        "command": "sourceReader.openSelection",
        "key": "enter",
        "when": "listFocus && view == sourceReader.relations",
        "args": "relations"
      }
    ],
    "themes": [
      {
        "id": "Source Reader Source Insight",
        "label": "Source Reader Source Insight",
        "uiTheme": "vs",
        "path": "./themes/source-insight-color-theme.json"
      }
    ],
    "colors": [
      {
        "id": "sourceReader.preview.keywordForeground",
        "description": "Source Reader Context keywordForeground",
        "defaults": {
          "dark": "symbolIcon.keywordForeground",
          "light": "symbolIcon.keywordForeground",
          "highContrast": "symbolIcon.keywordForeground",
          "highContrastLight": "symbolIcon.keywordForeground"
        }
      },
      {
        "id": "sourceReader.preview.controlForeground",
        "description": "Source Reader Context controlForeground",
        "defaults": {
          "dark": "symbolIcon.keywordForeground",
          "light": "symbolIcon.keywordForeground",
          "highContrast": "symbolIcon.keywordForeground",
          "highContrastLight": "symbolIcon.keywordForeground"
        }
      },
      {
        "id": "sourceReader.preview.typeForeground",
        "description": "Source Reader Context typeForeground",
        "defaults": {
          "dark": "symbolIcon.classForeground",
          "light": "symbolIcon.classForeground",
          "highContrast": "symbolIcon.classForeground",
          "highContrastLight": "symbolIcon.classForeground"
        }
      },
      {
        "id": "sourceReader.preview.functionForeground",
        "description": "Source Reader Context functionForeground",
        "defaults": {
          "dark": "symbolIcon.functionForeground",
          "light": "symbolIcon.functionForeground",
          "highContrast": "symbolIcon.functionForeground",
          "highContrastLight": "symbolIcon.functionForeground"
        }
      },
      {
        "id": "sourceReader.preview.stringForeground",
        "description": "Source Reader Context stringForeground",
        "defaults": {
          "dark": "debugTokenExpression.string",
          "light": "debugTokenExpression.string",
          "highContrast": "debugTokenExpression.string",
          "highContrastLight": "debugTokenExpression.string"
        }
      },
      {
        "id": "sourceReader.preview.stringBackground",
        "description": "Source Reader Context stringBackground",
        "defaults": {
          "dark": "#00000000",
          "light": "#00000000",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "sourceReader.preview.numberForeground",
        "description": "Source Reader Context numberForeground",
        "defaults": {
          "dark": "debugTokenExpression.number",
          "light": "debugTokenExpression.number",
          "highContrast": "debugTokenExpression.number",
          "highContrastLight": "debugTokenExpression.number"
        }
      },
      {
        "id": "sourceReader.preview.commentForeground",
        "description": "Source Reader Context commentForeground",
        "defaults": {
          "dark": "descriptionForeground",
          "light": "descriptionForeground",
          "highContrast": "descriptionForeground",
          "highContrastLight": "descriptionForeground"
        }
      },
      {
        "id": "sourceReader.preview.preprocessorForeground",
        "description": "Source Reader Context preprocessorForeground",
        "defaults": {
          "dark": "symbolIcon.keywordForeground",
          "light": "symbolIcon.keywordForeground",
          "highContrast": "symbolIcon.keywordForeground",
          "highContrastLight": "symbolIcon.keywordForeground"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.85",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
