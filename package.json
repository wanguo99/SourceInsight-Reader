{
  "name": "wanguo-sourceinsight-reader",
  "displayName": "SourceInsight-Reader",
  "description": "支持 C/C++、Java、Python 的 Source Insight 风格代码阅读：文件符号、定义预览、调用关系、引用与全文检索。C 内置基础索引；完整语义功能由 clangd、Red Hat Java、Pylance 等语言扩展提供。",
  "version": "1.0.9",
  "publisher": "wanguo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "check": "node scripts/check.js && tsc -p jsconfig.json && tsc -p tsconfig.domain.json",
    "test": "node scripts/test.js",
    "package": "node scripts/package.js",
    "test:host": "node test/run-host.js",
    "test:unit": "node scripts/test.js unit",
    "test:clangd": "node scripts/test.js clangd",
    "test:performance": "node --test test/performance-budgets.test.js",
    "benchmark": "node --expose-gc scripts/benchmark.js",
    "vscode:prepublish": "npm run check"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "sourceInsightReaderPanel",
          "title": "SourceInsight-Reader",
          "icon": "media/book.svg"
        },
        {
          "id": "sourceInsightReaderSearchPanel",
          "title": "Search Results",
          "icon": "media/book.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "sourceInsightReaderFiles",
          "title": "工程文件",
          "icon": "media/files.svg"
        }
      ],
      "activitybar": [
        {
          "id": "sourceInsightReaderSymbols",
          "title": "文件符号",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "sourceInsightReaderPanel": [
        {
          "id": "sourceInsightReader.context",
          "name": "Context / Relation",
          "type": "webview",
          "visibility": "visible"
        }
      ],
      "sourceInsightReaderFiles": [
        {
          "id": "sourceInsightReader.files",
          "name": "工程文件",
          "type": "webview",
          "visibility": "visible"
        }
      ],
      "sourceInsightReaderSymbols": [
        {
          "id": "sourceInsightReader.symbols",
          "name": "文件符号",
          "type": "webview"
        }
      ],
      "sourceInsightReaderSearchPanel": [
        {
          "id": "sourceInsightReader.searchResults",
          "name": "Search Results",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "sourceInsightReader.open",
        "title": "SourceInsight-Reader: 打开阅读工作台"
      },
      {
        "command": "sourceInsightReader.filterSymbols",
        "title": "筛选文件符号",
        "icon": "$(filter)"
      },
      {
        "command": "sourceInsightReader.sortSymbols",
        "title": "切换函数排序",
        "icon": "$(list-ordered)"
      },
      {
        "command": "sourceInsightReader.refreshSymbols",
        "title": "刷新函数列表",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightReader.previewDefinition",
        "title": "SourceInsight-Reader: 预览定义"
      },
      {
        "command": "sourceInsightReader.previewType",
        "title": "SourceInsight-Reader: 预览类型定义"
      },
      {
        "command": "sourceInsightReader.previewFile",
        "title": "在 Context 预览文件"
      },
      {
        "command": "sourceInsightReader.openTarget",
        "title": "在主编辑器打开",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceInsightReader.toggleContextLock",
        "title": "锁定/解锁 Context",
        "icon": "$(lock)"
      },
      {
        "command": "sourceInsightReader.refreshContext",
        "title": "刷新 Context",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightReader.incoming",
        "title": "SourceInsight-Reader: 谁调用它",
        "icon": "$(call-incoming)"
      },
      {
        "command": "sourceInsightReader.outgoing",
        "title": "SourceInsight-Reader: 它调用谁",
        "icon": "$(call-outgoing)"
      },
      {
        "command": "sourceInsightReader.setRoot",
        "title": "设为 Relation 根节点"
      },
      {
        "command": "sourceInsightReader.toggleRelationLock",
        "title": "锁定/解锁 Relation",
        "icon": "$(lock)"
      },
      {
        "command": "sourceInsightReader.refreshRelations",
        "title": "刷新 Relation",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightReader.lookupReferences",
        "title": "SourceInsight-Reader: Lookup References",
        "icon": "$(references)"
      },
      {
        "command": "sourceInsightReader.refreshReferences",
        "title": "刷新引用",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightReader.clearReferences",
        "title": "清除引用",
        "icon": "$(clear-all)"
      },
      {
        "command": "sourceInsightReader.back",
        "title": "SourceInsight-Reader: 阅读位置后退"
      },
      {
        "command": "sourceInsightReader.forward",
        "title": "SourceInsight-Reader: 阅读位置前进"
      },
      {
        "command": "sourceInsightReader.findFile",
        "title": "SourceInsight-Reader: 查找工程文件",
        "icon": "$(search)"
      },
      {
        "command": "sourceInsightReader.browseSymbols",
        "title": "SourceInsight-Reader: 查找全局符号",
        "icon": "$(symbol-method)"
      },
      {
        "command": "sourceInsightReader.jumpToDefinition",
        "title": "SourceInsight-Reader: 跳转到定义",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceInsightReader.openSelection",
        "title": "SourceInsight-Reader: 打开选中位置",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceInsightReader.contextMode",
        "title": "Context 跟随模式",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sourceInsightReader.filterReferences",
        "title": "筛选引用",
        "icon": "$(filter)"
      },
      {
        "command": "sourceInsightReader.referenceHistory",
        "title": "引用查询历史",
        "icon": "$(history)"
      },
      {
        "command": "sourceInsightReader.nextReference",
        "title": "SourceInsight-Reader: 下一个引用",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sourceInsightReader.previousReference",
        "title": "SourceInsight-Reader: 上一个引用",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sourceInsightReader.toggleSymbolKinds",
        "title": "切换全部符号/仅函数",
        "icon": "$(symbol-class)"
      },
      {
        "command": "sourceInsightReader.focusSymbols",
        "title": "SourceInsight-Reader: 聚焦文件符号"
      },
      {
        "command": "sourceInsightReader.focusContext",
        "title": "SourceInsight-Reader: 聚焦 Context"
      },
      {
        "command": "sourceInsightReader.focusRelations",
        "title": "SourceInsight-Reader: 聚焦 Relation"
      },
      {
        "command": "sourceInsightReader.focusReferences",
        "title": "SourceInsight-Reader: 聚焦引用结果"
      },
      {
        "command": "sourceInsightReader.applyLayout",
        "title": "SourceInsight-Reader: 应用 Source Insight 布局",
        "icon": "$(layout)"
      },
      {
        "command": "sourceInsightReader.restoreSidebar",
        "title": "SourceInsight-Reader: 恢复原侧栏位置"
      },
      {
        "command": "sourceInsightReader.rebuildIndex",
        "title": "SourceInsight-Reader: 重建本地 C 调用索引"
      },
      {
        "command": "sourceInsightReader.chooseRelationView",
        "title": "SourceInsight-Reader: 选择 Relation 显示方式"
      },
      {
        "command": "sourceInsightReader.focusFileSearch",
        "title": "SourceInsight-Reader: 聚焦工程文件"
      },
      {
        "command": "sourceInsightReader.refreshFileSearch",
        "title": "刷新工程文件",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightReader.lookupText",
        "title": "SourceInsight-Reader: Lookup Text（文件夹字符检索）"
      },
      {
        "command": "sourceInsightReader.focusTextLookup",
        "title": "SourceInsight-Reader: 聚焦字符检索结果"
      },
      {
        "command": "sourceInsightReader.nextTextMatch",
        "title": "SourceInsight-Reader: 下一处字符匹配"
      },
      {
        "command": "sourceInsightReader.previousTextMatch",
        "title": "SourceInsight-Reader: 上一处字符匹配"
      },
      {
        "command": "sourceInsightReader.toggleSymbolHighlight",
        "title": "SourceInsight-Reader: 固定 / 取消同名符号高亮"
      },
      {
        "command": "sourceInsightReader.clearSymbolHighlight",
        "title": "SourceInsight-Reader: 清除固定符号高亮"
      },
      {
        "command": "sourceInsightReader.openSettings",
        "title": "SourceInsight-Reader: 设置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sourceInsightReader.verifyRelations",
        "title": "SourceInsight-Reader: 使用语言服务复查调用关系",
        "icon": "$(check-all)"
      },
      {
        "command": "sourceInsightReader.manageReadingDirectories",
        "title": "SourceInsight-Reader: 管理屏蔽项",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sourceInsightReader.excludeDirectory",
        "title": "屏蔽所选文件 / 目录",
        "icon": "$(exclude)"
      },
      {
        "command": "sourceInsightReader.configureAppearance",
        "title": "SourceInsight-Reader: 外观配置（颜色、字体、背景）",
        "icon": "$(color-mode)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sourceInsightReader.filterSymbols",
          "when": "view == sourceInsightReader.symbols",
          "group": "navigation"
        },
        {
          "command": "sourceInsightReader.sortSymbols",
          "when": "view == sourceInsightReader.symbols"
        },
        {
          "command": "sourceInsightReader.refreshSymbols",
          "when": "view == sourceInsightReader.symbols"
        },
        {
          "command": "sourceInsightReader.toggleContextLock",
          "when": "view == sourceInsightReader.context"
        },
        {
          "command": "sourceInsightReader.refreshContext",
          "when": "view == sourceInsightReader.context"
        },
        {
          "command": "sourceInsightReader.browseSymbols",
          "when": "view == sourceInsightReader.symbols"
        },
        {
          "command": "sourceInsightReader.toggleSymbolKinds",
          "when": "view == sourceInsightReader.symbols"
        },
        {
          "command": "sourceInsightReader.contextMode",
          "when": "view == sourceInsightReader.context"
        },
        {
          "command": "sourceInsightReader.applyLayout",
          "when": "view == sourceInsightReader.symbols"
        },
        {
          "command": "sourceInsightReader.refreshFileSearch",
          "when": "view == sourceInsightReader.files",
          "group": "navigation"
        },
        {
          "command": "sourceInsightReader.openSettings",
          "when": "view == sourceInsightReader.symbols || view == sourceInsightReader.context || view == sourceInsightReader.files || view == sourceInsightReader.searchResults",
          "group": "navigation@99"
        },
        {
          "command": "sourceInsightReader.manageReadingDirectories",
          "when": "view == sourceInsightReader.symbols || view == sourceInsightReader.context || view == sourceInsightReader.files || view == sourceInsightReader.searchResults",
          "group": "navigation@80"
        }
      ],
      "view/item/context": [
        {
          "command": "sourceInsightReader.lookupReferences",
          "when": "viewItem == sourceInsightReader.symbol"
        },
        {
          "command": "sourceInsightReader.setRoot",
          "when": "viewItem == sourceInsightReader.symbol"
        }
      ],
      "editor/context": [
        {
          "command": "sourceInsightReader.jumpToDefinition",
          "group": "navigation@19"
        },
        {
          "command": "sourceInsightReader.previewDefinition",
          "group": "navigation@20"
        },
        {
          "command": "sourceInsightReader.lookupReferences",
          "group": "navigation@21"
        },
        {
          "command": "sourceInsightReader.setRoot",
          "group": "navigation@22"
        },
        {
          "command": "sourceInsightReader.lookupText",
          "group": "navigation@21"
        },
        {
          "command": "sourceInsightReader.toggleSymbolHighlight",
          "group": "navigation@22",
          "when": "editorTextFocus"
        }
      ],
      "webview/context": [
        {
          "command": "sourceInsightReader.excludeDirectory",
          "when": "webviewId == 'sourceInsightReader.files' && webviewSection == 'entry'",
          "group": "readingScope@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sourceInsightReader.excludeDirectory",
          "when": "false"
        },
        {
          "command": "sourceInsightReader.configureAppearance",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "SourceInsight-Reader",
      "properties": {
        "sourceInsightReader.navigationBackend": {
          "type": "string",
          "enum": ["auto", "local", "languageService"],
          "default": "auto",
          "description": "定义和符号查询策略：auto 优先在短预算内查询语言服务，再回退到本地 C 语法索引；local 仅本地；languageService 仅语言服务。"
        },
        "sourceInsightReader.queryTimeoutMs": {
          "type": "integer",
          "default": 5000,
          "minimum": 100,
          "maximum": 30000,
          "description": "引用等显式查询等待上限（毫秒）；自动定义使用至多 500ms 的语义等待，再尝试有界本地回退。超时后台命令仍占并发额度，避免请求堆积。"
        },
        "sourceInsightReader.workspaceSymbolTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 60000,
          "description": "全局符号搜索等待语言服务的上限（毫秒）；Java / Python 大项目可适当增加。"
        },
        "sourceInsightReader.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "光标停留时自动在 Context 预览定义。"
        },
        "sourceInsightReader.autoRelation": {
          "type": "boolean",
          "default": true,
          "description": "未锁定时 Relation 跟随当前函数。"
        },
        "sourceInsightReader.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 100,
          "maximum": 2000,
          "description": "自动查询防抖时间（毫秒）。"
        },
        "sourceInsightReader.contextLines": {
          "type": "integer",
          "default": 20,
          "minimum": 5,
          "maximum": 100,
          "description": "Context 目标上下显示的行数。"
        },
        "sourceInsightReader.files.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git",
            "**/node_modules"
          ],
          "description": "工程文件查找的额外排除 glob；支持 *、?、**，遵循 files.exclude。"
        },
        "sourceInsightReader.files.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "工程文件查找的包含 glob，空数组显示全部。"
        },
        "sourceInsightReader.symbolSort": {
          "type": "string",
          "enum": [
            "position",
            "name"
          ],
          "default": "position",
          "description": "函数列表排序方式。"
        },
        "sourceInsightReader.sourceInsightKeys": {
          "type": "boolean",
          "default": true,
          "description": "启用 Source Insight 风格的 Alt+=、Alt+,、Alt+.，并将 Shift+F12 路由至编辑区引用结果页；F8 浏览已查询引用。可关闭以恢复 VS Code 默认键位。"
        },
        "sourceInsightReader.contextMode": {
          "type": "string",
          "enum": [
            "definition",
            "type",
            "enclosing"
          ],
          "default": "definition",
          "description": "Context 默认查看当前符号自身的定义或声明，变量和字段不自动跳到类型；也可显式选择类型定义或包含函数。"
        },
        "sourceInsightReader.symbolKinds": {
          "type": "string",
          "enum": [
            "functions",
            "all"
          ],
          "default": "all",
          "description": "默认显示文件全部符号，包括 C/C++ 头文件包含、宏、全局变量、结构体、枚举和函数。functions 仅显示函数及其容器。"
        },
        "sourceInsightReader.layout": {
          "type": "string",
          "enum": [
            "sourceInsight",
            "preserve"
          ],
          "default": "sourceInsight",
          "scope": "window",
          "description": "控制底部阅读面板布局；默认不改变侧栏左右位置。Explorer 位置由 explorerSide 或 VS Code 原生布局控制，符号列表支持通过原生视图菜单移动。"
        },
        "sourceInsightReader.explorerSide": {
          "type": "string",
          "enum": [
            "preserve",
            "left",
            "right"
          ],
          "default": "preserve",
          "scope": "window",
          "enumDescriptions": [
            "保留主侧栏当前位置",
            "原生 Explorer 和符号列表所在的主侧栏放在左侧",
            "原生 Explorer 和符号列表所在的主侧栏放在右侧"
          ],
          "description": "主侧栏位置；默认首次应用左侧 Explorer 与符号列表、右侧工程文件。后续手动移动会保留，亦可用 left / right 切换主侧栏。"
        },
        "sourceInsightReader.relationBackend": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "languageService"
          ],
          "default": "auto",
          "enumDescriptions": [
            "优先使用语言服务，不可用时回退内置 C 语法索引",
            "C 源码只使用内置语法索引",
            "只使用已安装的语言服务"
          ],
          "description": "Relation 调用关系分析后端。auto 优先语言服务并在不可用时回退本地 C；local 无需 clangd 或编译数据库，不求值条件编译，不解析间接调用。"
        },
        "sourceInsightReader.indexExclude": {
          "type": "string",
          "default": "**/{.git,.cache,node_modules,build,dist,out,research}/**",
          "description": "本地 C 索引扫描排除规则（VS Code glob）。修改后自动重新扫描，也可运行重建索引命令。"
        },
        "sourceInsightReader.relationView": {
          "type": "string",
          "enum": [
            "horizontalGraph",
            "outline"
          ],
          "default": "horizontalGraph",
          "enumDescriptions": [
            "横向图：调用者 → 当前函数 → 调用函数，各一层",
            "原有树形列表：切换调用方向并逐级展开"
          ],
          "description": "Relation 的显示方式。横向图同时显示当前函数的直接调用者和直接调用函数；树形列表保留多级 Outline。"
        },
        "sourceInsightReader.textLookupExclude": {
          "type": "string",
          "default": "**/{.git,.cache,node_modules,build,dist,out,research}/**",
          "description": "文件夹字符检索额外排除规则；同时遵循 files.exclude / search.exclude 中值为 true 的规则。"
        },
        "sourceInsightReader.symbolHighlightUseF2": {
          "type": "boolean",
          "default": true,
          "description": "使用 F2 固定 / 取消同名符号高亮，覆盖 F2 原有重命名；关闭后保留 Ctrl+Alt+H 或命令入口。"
        },
        "sourceInsightReader.relationTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 250,
          "maximum": 30000,
          "description": "语言服务调用关系单次等待上限（毫秒）"
        },
        "sourceInsightReader.relationLocalTimeoutMs": {
          "type": "number",
          "default": 2000,
          "minimum": 250,
          "maximum": 15000,
          "description": "本地索引调用关系单次等待上限（毫秒），索引建立中不会无限阻塞窗口"
        },
        "sourceInsightReader.relationRetryDelayMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "同一工作区 / 语言 / 查询方向连续两次超时后暂停自动重试的时间（毫秒），手动刷新可立即重试"
        },
        "sourceInsightReader.indexEnabled": {
          "type": "boolean",
          "default": true,
          "description": "启用本地 C 索引，为符号、定义及调用关系查询提供数据；独立于 Relation 后端选择。"
        },
        "sourceInsightReader.excludedDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "scope": "window",
          "description": "屏蔽目录及其全部子目录，在扫描前排除。支持相对工作区路径、工作区内绝对路径或 URI，可在工程文件树中右键批量设置。"
        },
        "sourceInsightReader.autoConfigureClangd": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "根据屏蔽的文件和目录自动维护工作区 .clangd 的后台索引排除规则，保留已有编译配置。关闭后移除本插件规则。"
        },
        "sourceInsightReader.excludedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "scope": "window",
          "description": "屏蔽指定文件。可在工程文件树中 Shift 连选或 Ctrl / Cmd 多选后右键批量屏蔽。"
        },
        "sourceInsightReader.appearance.panes": {
          "type": "object",
          "default": {},
          "scope": "window",
          "additionalProperties": false,
          "properties": {
            "context": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fontFamily": {
                  "type": "string",
                  "default": ""
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 100
                },
                "foreground": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                },
                "background": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                }
              }
            },
            "relation": {
