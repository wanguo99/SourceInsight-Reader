{
  "name": "wanguo-sourceinsight-reader",
  "displayName": "SourceInsight-Reader",
  "description": "%manifest.description%",
  "version": "1.1.2",
  "publisher": "wanguo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "check": "node scripts/check.js && node scripts/update-docs.js --check && tsc -p jsconfig.json && tsc -p tsconfig.domain.json",
    "test": "node scripts/test.js",
    "package": "node scripts/package.js",
    "test:host": "node test/run-host.js",
    "test:unit": "node scripts/test.js unit",
    "test:clangd": "node scripts/test.js clangd",
    "test:performance": "node --test test/performance-budgets.test.js",
    "benchmark": "node --expose-gc scripts/benchmark.js",
    "vscode:prepublish": "npm run check",
    "verify:package": "node scripts/verify-package.js",
    "test:accuracy": "node --test test/accuracy-corpus.test.js",
    "test:soak": "node scripts/soak.js",
    "docs:update": "node scripts/update-docs.js",
    "docs:check": "node scripts/update-docs.js --check"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "sourceInsightReaderPanel",
          "title": "SourceInsight-Reader",
          "icon": "media/book.svg"
        },
        {
          "id": "sourceInsightReaderSearchPanel",
          "title": "Search Results",
          "icon": "media/book.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "sourceInsightReaderFiles",
          "title": "%manifest.contributes.viewsContainers.secondarySidebar.0.title%",
          "icon": "media/files.svg"
        }
      ],
      "activitybar": [
        {
          "id": "sourceInsightReaderSymbols",
          "title": "%manifest.contributes.viewsContainers.activitybar.0.title%",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "sourceInsightReaderPanel": [
        {
          "id": "sourceInsightReader.context",
          "name": "Context / Relation",
          "type": "webview",
          "visibility": "visible"
        }
      ],
      "sourceInsightReaderFiles": [
        {
          "id": "sourceInsightReader.files",
          "name": "%manifest.contributes.views.sourceInsightReaderFiles.0.name%",
          "type": "webview",
          "visibility": "visible"
        }
      ],
      "sourceInsightReaderSymbols": [
        {
          "id": "sourceInsightReader.symbols",
          "name": "%manifest.contributes.views.sourceInsightReaderSymbols.0.name%",
          "type": "webview"
        }
      ],
      "sourceInsightReaderSearchPanel": [
        {
          "id": "sourceInsightReader.searchResults",
          "name": "Search Results",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "sourceInsightReader.open",
        "title": "%command.open%"
      },
      {
        "command": "sourceInsightReader.filterSymbols",
        "title": "%command.filterSymbols%",
        "icon": "$(filter)"
      },
      {
        "command": "sourceInsightReader.sortSymbols",
        "title": "%command.sortSymbols%",
        "icon": "$(list-ordered)"
      },
      {
        "command": "sourceInsightReader.refreshSymbols",
        "title": "%command.refreshSymbols%",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightReader.previewDefinition",
        "title": "%command.previewDefinition%"
      },
      {
        "command": "sourceInsightReader.previewType",
        "title": "%command.previewType%"
      },
      {
        "command": "sourceInsightReader.previewFile",
        "title": "%command.previewFile%"
      },
      {
        "command": "sourceInsightReader.openTarget",
        "title": "%command.openTarget%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceInsightReader.toggleContextLock",
        "title": "%command.toggleContextLock%",
        "icon": "$(lock)"
      },
      {
        "command": "sourceInsightReader.refreshContext",
        "title": "%command.refreshContext%",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightReader.incoming",
        "title": "%command.incoming%",
        "icon": "$(call-incoming)"
      },
      {
        "command": "sourceInsightReader.outgoing",
        "title": "%command.outgoing%",
        "icon": "$(call-outgoing)"
      },
      {
        "command": "sourceInsightReader.setRoot",
        "title": "%command.setRoot%"
      },
      {
        "command": "sourceInsightReader.toggleRelationLock",
        "title": "%command.toggleRelationLock%",
        "icon": "$(lock)"
      },
      {
        "command": "sourceInsightReader.refreshRelations",
        "title": "%command.refreshRelations%",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightReader.lookupReferences",
        "title": "%command.lookupReferences%",
        "icon": "$(references)"
      },
      {
        "command": "sourceInsightReader.refreshReferences",
        "title": "%command.refreshReferences%",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightReader.clearReferences",
        "title": "%command.clearReferences%",
        "icon": "$(clear-all)"
      },
      {
        "command": "sourceInsightReader.back",
        "title": "%command.back%"
      },
      {
        "command": "sourceInsightReader.forward",
        "title": "%command.forward%"
      },
      {
        "command": "sourceInsightReader.findFile",
        "title": "%command.findFile%",
        "icon": "$(search)"
      },
      {
        "command": "sourceInsightReader.browseSymbols",
        "title": "%command.browseSymbols%",
        "icon": "$(symbol-method)"
      },
      {
        "command": "sourceInsightReader.jumpToDefinition",
        "title": "%command.jumpToDefinition%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceInsightReader.openSelection",
        "title": "%command.openSelection%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceInsightReader.contextMode",
        "title": "%command.contextMode%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sourceInsightReader.filterReferences",
        "title": "%command.filterReferences%",
        "icon": "$(filter)"
      },
      {
        "command": "sourceInsightReader.referenceHistory",
        "title": "%command.referenceHistory%",
        "icon": "$(history)"
      },
      {
        "command": "sourceInsightReader.nextReference",
        "title": "%command.nextReference%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sourceInsightReader.previousReference",
        "title": "%command.previousReference%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sourceInsightReader.toggleSymbolKinds",
        "title": "%command.toggleSymbolKinds%",
        "icon": "$(symbol-class)"
      },
      {
        "command": "sourceInsightReader.focusSymbols",
        "title": "%command.focusSymbols%"
      },
      {
        "command": "sourceInsightReader.focusContext",
        "title": "%command.focusContext%"
      },
      {
        "command": "sourceInsightReader.focusRelations",
        "title": "%command.focusRelations%"
      },
      {
        "command": "sourceInsightReader.focusReferences",
        "title": "%command.focusReferences%"
      },
      {
        "command": "sourceInsightReader.applyLayout",
        "title": "%command.applyLayout%",
        "icon": "$(layout)"
      },
      {
        "command": "sourceInsightReader.restoreSidebar",
        "title": "%command.restoreSidebar%"
      },
      {
        "command": "sourceInsightReader.rebuildIndex",
        "title": "%command.rebuildIndex%"
      },
      {
        "command": "sourceInsightReader.indexIssues",
        "title": "%command.indexIssues%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.chooseRelationView",
        "title": "%command.chooseRelationView%"
      },
      {
        "command": "sourceInsightReader.focusFileSearch",
        "title": "%command.focusFileSearch%"
      },
      {
        "command": "sourceInsightReader.refreshFileSearch",
        "title": "%command.refreshFileSearch%",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightReader.lookupText",
        "title": "%command.lookupText%"
      },
      {
        "command": "sourceInsightReader.focusTextLookup",
        "title": "%command.focusTextLookup%"
      },
      {
        "command": "sourceInsightReader.nextTextMatch",
        "title": "%command.nextTextMatch%"
      },
      {
        "command": "sourceInsightReader.previousTextMatch",
        "title": "%command.previousTextMatch%"
      },
      {
        "command": "sourceInsightReader.toggleSymbolHighlight",
        "title": "%command.toggleSymbolHighlight%"
      },
      {
        "command": "sourceInsightReader.clearSymbolHighlight",
        "title": "%command.clearSymbolHighlight%"
      },
      {
        "command": "sourceInsightReader.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sourceInsightReader.verifyRelations",
        "title": "%command.verifyRelations%",
        "icon": "$(check-all)"
      },
      {
        "command": "sourceInsightReader.manageReadingDirectories",
        "title": "%command.manageReadingDirectories%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sourceInsightReader.excludeDirectory",
        "title": "%command.excludeDirectory%",
        "icon": "$(exclude)"
      },
      {
        "command": "sourceInsightReader.configureAppearance",
        "title": "%command.configureAppearance%",
        "icon": "$(color-mode)"
      },
      {
        "command": "sourceInsightReader.diagnostics",
        "title": "%command.diagnostics%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.exportDiagnostics",
        "title": "%command.exportDiagnostics%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.keyboardPreset",
        "title": "%command.keyboardPreset%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.configureClangd",
        "title": "%command.configureClangd%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.restoreClangd",
        "title": "%command.restoreClangd%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.addBookmark",
        "title": "%command.addBookmark%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.bookmarks",
        "title": "%command.bookmarks%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.saveReadingTask",
        "title": "%command.saveReadingTask%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.restoreReadingTask",
        "title": "%command.restoreReadingTask%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.saveSearch",
        "title": "%command.saveSearch%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.savedSearches",
        "title": "%command.savedSearches%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.exploreRelations",
        "title": "%command.exploreRelations%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.pinContext",
        "title": "%command.pinContext%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.welcome",
        "title": "%command.welcome%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.clearReadingData",
        "title": "%command.clearReadingData%",
        "category": "SourceInsight-Reader"
      },
      {
        "command": "sourceInsightReader.manageCache",
        "title": "%command.manageCache%",
        "icon": "$(database)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sourceInsightReader.filterSymbols",
          "when": "view == sourceInsightReader.symbols",
          "group": "navigation"
        },
        {
          "command": "sourceInsightReader.sortSymbols",
          "when": "view == sourceInsightReader.symbols"
        },
        {
          "command": "sourceInsightReader.refreshSymbols",
          "when": "view == sourceInsightReader.symbols"
        },
        {
          "command": "sourceInsightReader.toggleContextLock",
          "when": "view == sourceInsightReader.context"
        },
        {
          "command": "sourceInsightReader.refreshContext",
          "when": "view == sourceInsightReader.context"
        },
        {
          "command": "sourceInsightReader.browseSymbols",
          "when": "view == sourceInsightReader.symbols"
        },
        {
          "command": "sourceInsightReader.toggleSymbolKinds",
          "when": "view == sourceInsightReader.symbols"
        },
        {
          "command": "sourceInsightReader.contextMode",
          "when": "view == sourceInsightReader.context"
        },
        {
          "command": "sourceInsightReader.applyLayout",
          "when": "view == sourceInsightReader.symbols"
        },
        {
          "command": "sourceInsightReader.refreshFileSearch",
          "when": "view == sourceInsightReader.files",
          "group": "navigation"
        },
        {
          "command": "sourceInsightReader.openSettings",
          "when": "view == sourceInsightReader.symbols || view == sourceInsightReader.context || view == sourceInsightReader.files || view == sourceInsightReader.searchResults",
          "group": "navigation@99"
        },
        {
          "command": "sourceInsightReader.manageReadingDirectories",
          "when": "view == sourceInsightReader.symbols || view == sourceInsightReader.context || view == sourceInsightReader.files || view == sourceInsightReader.searchResults",
          "group": "navigation@80"
        },
        {
          "command": "sourceInsightReader.manageCache",
          "when": "view == sourceInsightReader.files || view == sourceInsightReader.symbols || view == sourceInsightReader.context",
          "group": "cache@1"
        }
      ],
      "view/item/context": [
        {
          "command": "sourceInsightReader.lookupReferences",
          "when": "viewItem == sourceInsightReader.symbol"
        },
        {
          "command": "sourceInsightReader.setRoot",
          "when": "viewItem == sourceInsightReader.symbol"
        }
      ],
      "editor/context": [
        {
          "command": "sourceInsightReader.jumpToDefinition",
          "group": "navigation@19"
        },
        {
          "command": "sourceInsightReader.previewDefinition",
          "group": "navigation@20"
        },
        {
          "command": "sourceInsightReader.lookupReferences",
          "group": "navigation@21"
        },
        {
          "command": "sourceInsightReader.setRoot",
          "group": "navigation@22"
        },
        {
          "command": "sourceInsightReader.lookupText",
          "group": "navigation@21"
        },
        {
          "command": "sourceInsightReader.toggleSymbolHighlight",
          "group": "navigation@22",
          "when": "editorTextFocus"
        }
      ],
      "webview/context": [
        {
          "command": "sourceInsightReader.excludeDirectory",
          "when": "webviewId == 'sourceInsightReader.files' && webviewSection == 'entry'",
          "group": "readingScope@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sourceInsightReader.excludeDirectory",
          "when": "false"
        },
        {
          "command": "sourceInsightReader.configureAppearance",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "SourceInsight-Reader",
      "properties": {
        "sourceInsightReader.navigationBackend": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "languageService"
          ],
          "default": "auto",
          "description": "%setting.navigationBackend%"
        },
        "sourceInsightReader.queryTimeoutMs": {
          "type": "integer",
          "default": 5000,
          "minimum": 100,
          "maximum": 30000,
          "description": "%setting.queryTimeoutMs%"
        },
        "sourceInsightReader.workspaceSymbolTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 60000,
          "description": "%setting.workspaceSymbolTimeoutMs%"
        },
        "sourceInsightReader.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "%setting.autoPreview%"
        },
        "sourceInsightReader.autoRelation": {
          "type": "boolean",
          "default": true,
          "description": "%setting.autoRelation%"
        },
        "sourceInsightReader.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 100,
          "maximum": 2000,
          "description": "%setting.debounceMs%"
        },
        "sourceInsightReader.contextLines": {
          "type": "integer",
          "default": 20,
          "minimum": 5,
          "maximum": 100,
          "description": "%setting.contextLines%"
        },
        "sourceInsightReader.files.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git",
            "**/node_modules"
          ],
          "description": "%setting.files.exclude%"
        },
        "sourceInsightReader.files.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.files.include%"
        },
        "sourceInsightReader.symbolSort": {
          "type": "string",
          "enum": [
            "position",
            "name"
          ],
          "default": "position",
          "description": "%setting.symbolSort%"
        },
        "sourceInsightReader.sourceInsightKeys": {
          "type": "boolean",
          "default": false,
          "description": "%setting.sourceInsightKeys%"
        },
        "sourceInsightReader.contextMode": {
          "type": "string",
          "enum": [
            "definition",
            "type",
            "enclosing"
          ],
          "default": "definition",
          "description": "%setting.contextMode%"
        },
        "sourceInsightReader.symbolKinds": {
          "type": "string",
          "enum": [
            "functions",
            "all"
          ],
          "default": "all",
          "description": "%setting.symbolKinds%"
        },
        "sourceInsightReader.layout": {
          "type": "string",
          "enum": [
            "sourceInsight",
            "preserve"
          ],
          "default": "preserve",
          "scope": "window",
          "description": "%setting.layout%"
        },
        "sourceInsightReader.explorerSide": {
          "type": "string",
          "enum": [
            "preserve",
            "left",
            "right"
          ],
          "default": "preserve",
          "scope": "window",
          "enumDescriptions": [
            "%enum.explorerSide.preserve%",
            "%enum.explorerSide.left%",
            "%enum.explorerSide.right%"
          ],
          "description": "%setting.explorerSide%"
        },
        "sourceInsightReader.relationBackend": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "languageService"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%enum.relationBackend.auto%",
            "%enum.relationBackend.local%",
            "%enum.relationBackend.languageService%"
          ],
          "description": "%setting.relationBackend%"
        },
        "sourceInsightReader.indexExclude": {
          "type": "string",
          "default": "**/{.git,.cache,node_modules,build,dist,out,research}/**",
          "description": "%setting.indexExclude%"
        },
        "sourceInsightReader.relationView": {
          "type": "string",
          "enum": [
            "horizontalGraph",
            "outline"
          ],
          "default": "horizontalGraph",
          "enumDescriptions": [
            "%enum.relationView.horizontalGraph%",
            "%enum.relationView.outline%"
          ],
          "description": "%setting.relationView%"
        },
        "sourceInsightReader.textLookupExclude": {
          "type": "string",
          "default": "**/{.git,.cache,node_modules,build,dist,out,research}/**",
          "description": "%setting.textLookupExclude%"
        },
        "sourceInsightReader.symbolHighlightUseF2": {
          "type": "boolean",
          "default": false,
          "description": "%setting.symbolHighlightUseF2%"
        },
        "sourceInsightReader.relationTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 250,
          "maximum": 30000,
          "description": "%setting.relationTimeoutMs%"
        },
        "sourceInsightReader.relationLocalTimeoutMs": {
          "type": "number",
          "default": 2000,
          "minimum": 250,
          "maximum": 15000,
          "description": "%setting.relationLocalTimeoutMs%"
        },
        "sourceInsightReader.relationRetryDelayMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "%setting.relationRetryDelayMs%"
        },
        "sourceInsightReader.indexEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.indexEnabled%"
        },
        "sourceInsightReader.excludedDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "scope": "window",
          "description": "%setting.excludedDirectories%"
        },
        "sourceInsightReader.autoConfigureClangd": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%setting.autoConfigureClangd%"
        },
        "sourceInsightReader.excludedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "scope": "window",
          "description": "%setting.excludedFiles%"
        },
        "sourceInsightReader.appearance.panes": {
          "type": "object",
          "default": {},
          "scope": "window",
          "additionalProperties": false,
          "properties": {
            "context": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fontFamily": {
                  "type": "string",
                  "default": ""
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 100
                },
                "foreground": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                },
                "background": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                }
              }
            },
            "relation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fontFamily": {
                  "type": "string",
                  "default": ""
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 100
                },
                "foreground": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                },
                "background": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                }
              }
            },
            "symbols": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fontFamily": {
                  "type": "string",
                  "default": ""
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 100
                },
                "foreground": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                },
                "background": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                }
              }
            },
            "files": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fontFamily": {
                  "type": "string",
                  "default": ""
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 100
                },
                "foreground": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                },
                "background": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                }
              }
            },
            "search": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fontFamily": {
                  "type": "string",
                  "default": ""
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 100
                },
                "foreground": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                },
                "background": {
                  "type": "string",
                  "pattern": "^$|^#[0-9a-fA-F]{6}$"
                }
              }
            }
          },
          "markdownDescription": "%setting.appearance.panes%"
        },
        "sourceInsightReader.indexCpuLimitPercent": {
          "type": "integer",
          "default": 25,
          "minimum": 5,
          "maximum": 25,
          "scope": "window",
          "description": "%setting.indexCpuLimitPercent%"
        },
        "sourceInsightReader.indexMemoryLimitMb": {
          "type": "integer",
          "default": 1024,
          "minimum": 128,
          "maximum": 8192,
          "scope": "window",
          "description": "%setting.indexMemoryLimitMb%"
        },
        "sourceInsightReader.fileLoggingEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%config.fileLoggingEnabled%"
        },
        "sourceInsightReader.cacheDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%config.cacheDirectory%"
        }
      }
    },
    "keybindings": [
      {
        "command": "sourceInsightReader.jumpToDefinition",
        "key": "alt+=",
        "when": "config.sourceInsightReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.back",
        "key": "alt+,",
        "when": "config.sourceInsightReader.sourceInsightKeys && (editorTextFocus || listFocus)"
      },
      {
        "command": "sourceInsightReader.forward",
        "key": "alt+.",
        "when": "config.sourceInsightReader.sourceInsightKeys && (editorTextFocus || listFocus)"
      },
      {
        "command": "sourceInsightReader.lookupReferences",
        "key": "shift+f12",
        "when": "config.sourceInsightReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.browseSymbols",
        "key": "alt+shift+s",
        "when": "config.sourceInsightReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.findFile",
        "key": "alt+shift+p",
        "when": "config.sourceInsightReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.nextReference",
        "key": "alt+f8",
        "when": "config.sourceInsightReader.sourceInsightKeys && (sourceInsightReader.hasReferences || sourceInsightReader.hasTextMatches) && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.previousReference",
        "key": "alt+shift+f8",
        "when": "config.sourceInsightReader.sourceInsightKeys && (sourceInsightReader.hasReferences || sourceInsightReader.hasTextMatches) && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.toggleSymbolHighlight",
        "key": "f8",
        "when": "editorTextFocus"
      },
      {
        "command": "sourceInsightReader.toggleSymbolHighlight",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      },
      {
        "command": "sourceInsightReader.toggleSymbolHighlight",
        "key": "f2",
        "when": "editorTextFocus && config.sourceInsightReader.symbolHighlightUseF2"
      }
    ],
    "themes": [
