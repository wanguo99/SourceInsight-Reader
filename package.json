          "markdownDescription": "各阅读窗口的字体、字号、文字和背景颜色。使用 **SourceInsight-Reader: 设置** 页的 **外观设置** 标签编辑；留空继承主题。"
        }
      }
    },
    "keybindings": [
      {
        "command": "sourceInsightReader.jumpToDefinition",
        "key": "alt+=",
        "when": "config.sourceInsightReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.back",
        "key": "alt+,",
        "when": "config.sourceInsightReader.sourceInsightKeys && (editorTextFocus || listFocus)"
      },
      {
        "command": "sourceInsightReader.forward",
        "key": "alt+.",
        "when": "config.sourceInsightReader.sourceInsightKeys && (editorTextFocus || listFocus)"
      },
      {
        "command": "sourceInsightReader.lookupReferences",
        "key": "shift+f12",
        "when": "config.sourceInsightReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.browseSymbols",
        "key": "alt+shift+s",
        "when": "config.sourceInsightReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.findFile",
        "key": "alt+shift+p",
        "when": "config.sourceInsightReader.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.nextReference",
        "key": "f8",
        "when": "config.sourceInsightReader.sourceInsightKeys && (sourceInsightReader.hasReferences || sourceInsightReader.hasTextMatches) && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.previousReference",
        "key": "shift+f8",
        "when": "config.sourceInsightReader.sourceInsightKeys && (sourceInsightReader.hasReferences || sourceInsightReader.hasTextMatches) && editorTextFocus"
      },
      {
        "command": "sourceInsightReader.toggleSymbolHighlight",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      },
      {
        "command": "sourceInsightReader.toggleSymbolHighlight",
        "key": "f2",
        "when": "editorTextFocus && config.sourceInsightReader.symbolHighlightUseF2"
      }
    ],
