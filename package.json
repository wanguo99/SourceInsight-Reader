            "description": "%manifest.contributes.walkthroughs.0.steps.0.description%",
            "media": {
              "markdown": "docs/walkthrough.md"
            },
            "completionEvents": [
              "onCommand:sourceInsightReader.diagnostics"
            ]
          },
          {
            "id": "read",
            "title": "%manifest.contributes.walkthroughs.0.steps.1.title%",
            "description": "%manifest.contributes.walkthroughs.0.steps.1.description%",
