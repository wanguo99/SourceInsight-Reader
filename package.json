{
  "name": "source-insight-inspired",
  "displayName": "Source Insight Inspired",
  "description": "受 Source Insight 启发，复刻符号浏览、Context 预览和 Relation 调用关系阅读体验的非官方独立插件。",
  "version": "0.10.16",
  "publisher": "local-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "check": "node scripts/check.js && tsc -p jsconfig.json",
    "test": "node scripts/test.js",
    "package": "node scripts/package.js",
    "test:host": "node test/run-host.js",
    "test:unit": "node scripts/test.js unit",
    "test:clangd": "node scripts/test.js clangd",
    "vscode:prepublish": "npm run check"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "sourceInsightInspiredPanel",
          "title": "Source Insight Inspired",
          "icon": "media/book.svg"
        },
        {
          "id": "sourceInsightInspiredSearchPanel",
          "title": "Search Results",
          "icon": "media/book.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "sourceInsightInspiredFiles",
          "title": "工程文件",
          "icon": "media/files.svg"
        }
      ],
      "activitybar": [
        {
          "id": "sourceInsightInspiredSymbols",
          "title": "文件符号",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "sourceInsightInspiredPanel": [
        {
          "id": "sourceInsightInspired.context",
          "name": "Context / Relation",
          "type": "webview",
          "visibility": "visible"
        }
      ],
      "sourceInsightInspiredFiles": [
        {
          "id": "sourceInsightInspired.files",
          "name": "工程文件",
          "type": "webview",
          "visibility": "visible"
        }
      ],
      "sourceInsightInspiredSymbols": [
        {
          "id": "sourceInsightInspired.symbols",
          "name": "文件符号",
          "type": "webview"
        }
      ],
      "sourceInsightInspiredSearchPanel": [
        {
          "id": "sourceInsightInspired.searchResults",
          "name": "Search Results",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "sourceInsightInspired.open",
        "title": "Source Insight Inspired: 打开阅读工作台"
      },
      {
        "command": "sourceInsightInspired.filterSymbols",
        "title": "筛选文件符号",
        "icon": "$(filter)"
      },
      {
        "command": "sourceInsightInspired.sortSymbols",
        "title": "切换函数排序",
        "icon": "$(list-ordered)"
      },
      {
        "command": "sourceInsightInspired.refreshSymbols",
        "title": "刷新函数列表",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightInspired.previewDefinition",
        "title": "Source Insight Inspired: 预览定义"
      },
      {
        "command": "sourceInsightInspired.previewType",
        "title": "Source Insight Inspired: 预览类型定义"
      },
      {
        "command": "sourceInsightInspired.previewFile",
        "title": "在 Context 预览文件"
      },
      {
        "command": "sourceInsightInspired.openTarget",
        "title": "在主编辑器打开",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceInsightInspired.toggleContextLock",
        "title": "锁定/解锁 Context",
        "icon": "$(lock)"
      },
      {
        "command": "sourceInsightInspired.refreshContext",
        "title": "刷新 Context",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightInspired.incoming",
        "title": "Source Insight Inspired: 谁调用它",
        "icon": "$(call-incoming)"
      },
      {
        "command": "sourceInsightInspired.outgoing",
        "title": "Source Insight Inspired: 它调用谁",
        "icon": "$(call-outgoing)"
      },
      {
        "command": "sourceInsightInspired.setRoot",
        "title": "设为 Relation 根节点"
      },
      {
        "command": "sourceInsightInspired.toggleRelationLock",
        "title": "锁定/解锁 Relation",
        "icon": "$(lock)"
      },
      {
        "command": "sourceInsightInspired.refreshRelations",
        "title": "刷新 Relation",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightInspired.lookupReferences",
        "title": "Source Insight Inspired: Lookup References",
        "icon": "$(references)"
      },
      {
        "command": "sourceInsightInspired.refreshReferences",
        "title": "刷新引用",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightInspired.clearReferences",
        "title": "清除引用",
        "icon": "$(clear-all)"
      },
      {
        "command": "sourceInsightInspired.back",
        "title": "Source Insight Inspired: 阅读位置后退"
      },
      {
        "command": "sourceInsightInspired.forward",
        "title": "Source Insight Inspired: 阅读位置前进"
      },
      {
        "command": "sourceInsightInspired.findFile",
        "title": "Source Insight Inspired: 查找工程文件",
        "icon": "$(search)"
      },
      {
        "command": "sourceInsightInspired.browseSymbols",
        "title": "Source Insight Inspired: 查找全局符号",
        "icon": "$(symbol-method)"
      },
      {
        "command": "sourceInsightInspired.jumpToDefinition",
        "title": "Source Insight Inspired: 跳转到定义",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceInsightInspired.openSelection",
        "title": "Source Insight Inspired: 打开选中位置",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sourceInsightInspired.contextMode",
        "title": "Context 跟随模式",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sourceInsightInspired.filterReferences",
        "title": "筛选引用",
        "icon": "$(filter)"
      },
      {
        "command": "sourceInsightInspired.referenceHistory",
        "title": "引用查询历史",
        "icon": "$(history)"
      },
      {
        "command": "sourceInsightInspired.nextReference",
        "title": "Source Insight Inspired: 下一个引用",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sourceInsightInspired.previousReference",
        "title": "Source Insight Inspired: 上一个引用",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sourceInsightInspired.toggleSymbolKinds",
        "title": "切换全部符号/仅函数",
        "icon": "$(symbol-class)"
      },
      {
        "command": "sourceInsightInspired.focusSymbols",
        "title": "Source Insight Inspired: 聚焦文件符号"
      },
      {
        "command": "sourceInsightInspired.focusContext",
        "title": "Source Insight Inspired: 聚焦 Context"
      },
      {
        "command": "sourceInsightInspired.focusRelations",
        "title": "Source Insight Inspired: 聚焦 Relation"
      },
      {
        "command": "sourceInsightInspired.focusReferences",
        "title": "Source Insight Inspired: 聚焦引用结果"
      },
      {
        "command": "sourceInsightInspired.applyLayout",
        "title": "Source Insight Inspired: 应用 Source Insight 布局",
        "icon": "$(layout)"
      },
      {
        "command": "sourceInsightInspired.restoreSidebar",
        "title": "Source Insight Inspired: 恢复原侧栏位置"
      },
      {
        "command": "sourceInsightInspired.rebuildIndex",
        "title": "Source Insight Inspired: 重建本地 C 调用索引"
      },
      {
        "command": "sourceInsightInspired.chooseRelationView",
        "title": "Source Insight Inspired: 选择 Relation 显示方式"
      },
      {
        "command": "sourceInsightInspired.focusFileSearch",
        "title": "Source Insight Inspired: 聚焦工程文件"
      },
      {
        "command": "sourceInsightInspired.refreshFileSearch",
        "title": "刷新工程文件",
        "icon": "$(refresh)"
      },
      {
        "command": "sourceInsightInspired.lookupText",
        "title": "Source Insight Inspired: Lookup Text（文件夹字符检索）"
      },
      {
        "command": "sourceInsightInspired.focusTextLookup",
        "title": "Source Insight Inspired: 聚焦字符检索结果"
      },
      {
        "command": "sourceInsightInspired.nextTextMatch",
        "title": "Source Insight Inspired: 下一处字符匹配"
      },
      {
        "command": "sourceInsightInspired.previousTextMatch",
        "title": "Source Insight Inspired: 上一处字符匹配"
      },
      {
        "command": "sourceInsightInspired.toggleSymbolHighlight",
        "title": "Source Insight Inspired: 固定 / 取消同名符号高亮"
      },
      {
        "command": "sourceInsightInspired.clearSymbolHighlight",
        "title": "Source Insight Inspired: 清除固定符号高亮"
      },
      {
        "command": "sourceInsightInspired.openSettings",
        "title": "Source Insight Inspired: 功能设置",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sourceInsightInspired.filterSymbols",
          "when": "view == sourceInsightInspired.symbols",
          "group": "navigation"
        },
        {
          "command": "sourceInsightInspired.sortSymbols",
          "when": "view == sourceInsightInspired.symbols"
        },
        {
          "command": "sourceInsightInspired.refreshSymbols",
          "when": "view == sourceInsightInspired.symbols"
        },
        {
          "command": "sourceInsightInspired.toggleContextLock",
          "when": "view == sourceInsightInspired.context"
        },
        {
          "command": "sourceInsightInspired.refreshContext",
          "when": "view == sourceInsightInspired.context"
        },
        {
          "command": "sourceInsightInspired.browseSymbols",
          "when": "view == sourceInsightInspired.symbols"
        },
        {
          "command": "sourceInsightInspired.toggleSymbolKinds",
          "when": "view == sourceInsightInspired.symbols"
        },
        {
          "command": "sourceInsightInspired.contextMode",
          "when": "view == sourceInsightInspired.context"
        },
        {
          "command": "sourceInsightInspired.applyLayout",
          "when": "view == sourceInsightInspired.symbols"
        },
        {
          "command": "sourceInsightInspired.refreshFileSearch",
          "when": "view == sourceInsightInspired.files",
          "group": "navigation"
        },
        {
          "command": "sourceInsightInspired.openSettings",
          "when": "view == sourceInsightInspired.symbols || view == sourceInsightInspired.context || view == sourceInsightInspired.files || view == sourceInsightInspired.searchResults",
          "group": "navigation@99"
        }
      ],
      "view/item/context": [
        {
          "command": "sourceInsightInspired.lookupReferences",
          "when": "viewItem == sourceInsightInspired.symbol"
        },
        {
          "command": "sourceInsightInspired.setRoot",
          "when": "viewItem == sourceInsightInspired.symbol"
        }
      ],
      "editor/context": [
        {
          "command": "sourceInsightInspired.jumpToDefinition",
          "group": "navigation@19"
        },
        {
          "command": "sourceInsightInspired.previewDefinition",
          "group": "navigation@20"
        },
        {
          "command": "sourceInsightInspired.lookupReferences",
          "group": "navigation@21"
        },
        {
          "command": "sourceInsightInspired.setRoot",
          "group": "navigation@22"
        },
        {
          "command": "sourceInsightInspired.lookupText",
          "group": "navigation@21"
        },
        {
          "command": "sourceInsightInspired.toggleSymbolHighlight",
          "group": "navigation@22",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "Source Insight Inspired",
      "properties": {
        "sourceInsightInspired.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "光标停留时自动在 Context 预览定义。"
        },
        "sourceInsightInspired.autoRelation": {
          "type": "boolean",
          "default": true,
          "description": "未锁定时 Relation 跟随当前函数。"
        },
        "sourceInsightInspired.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 100,
          "maximum": 2000,
          "description": "自动查询防抖时间（毫秒）。"
        },
        "sourceInsightInspired.contextLines": {
          "type": "integer",
          "default": 20,
          "minimum": 5,
          "maximum": 100,
          "description": "Context 目标上下显示的行数。"
        },
        "sourceInsightInspired.files.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git",
            "**/node_modules"
          ],
          "description": "工程文件查找的额外排除 glob；支持 *、?、**，遵循 files.exclude。"
        },
        "sourceInsightInspired.files.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "工程文件查找的包含 glob，空数组显示全部。"
        },
        "sourceInsightInspired.symbolSort": {
          "type": "string",
          "enum": [
            "position",
            "name"
          ],
          "default": "position",
          "description": "函数列表排序方式。"
        },
        "sourceInsightInspired.sourceInsightKeys": {
          "type": "boolean",
          "default": true,
          "description": "启用 Source Insight 风格的 Alt+=、Alt+,、Alt+.，并将 Shift+F12 路由至编辑区引用结果页；F8 浏览已查询引用。可关闭以恢复 VS Code 默认键位。"
        },
        "sourceInsightInspired.contextMode": {
          "type": "string",
          "enum": [
            "definition",
            "type",
            "enclosing"
          ],
          "default": "definition",
          "description": "Context 智能跟随：函数、标量变量和数组查看定义，结构体/类/枚举对象可预览类型；也可强制类型定义或包含函数。"
        },
        "sourceInsightInspired.symbolKinds": {
          "type": "string",
          "enum": [
            "functions",
            "all"
          ],
          "default": "all",
          "description": "默认显示文件全部符号，包括 C/C++ 头文件包含、宏、全局变量、结构体、枚举和函数。functions 仅显示函数及其容器。"
        },
        "sourceInsightInspired.layout": {
          "type": "string",
          "enum": [
            "sourceInsight",
            "preserve"
          ],
          "default": "sourceInsight",
          "scope": "window",
          "description": "控制底部阅读面板布局；默认不改变侧栏左右位置。Explorer 位置由 explorerSide 或 VS Code 原生布局控制，符号列表支持通过原生视图菜单移动。"
        },
        "sourceInsightInspired.explorerSide": {
          "type": "string",
          "enum": [
            "preserve",
            "left",
            "right"
          ],
          "default": "preserve",
          "scope": "window",
          "enumDescriptions": [
            "保留主侧栏当前位置",
            "原生 Explorer 和符号列表所在的主侧栏放在左侧",
            "原生 Explorer 和符号列表所在的主侧栏放在右侧"
          ],
          "description": "主侧栏位置；默认首次应用左侧 Explorer 与符号列表、右侧工程文件。后续手动移动会保留，亦可用 left / right 切换主侧栏。"
        },
        "sourceInsightInspired.relationBackend": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "languageService"
          ],
          "default": "auto",
          "enumDescriptions": [
            "C 源码优先使用内置语法索引，其余使用语言服务",
            "C 源码只使用内置语法索引",
            "只使用已安装的语言服务"
          ],
          "description": "Relation 调用关系分析后端。本地 C 索引无需 clangd 或编译数据库，不求值条件编译，不解析间接调用。"
        },
        "sourceInsightInspired.indexExclude": {
          "type": "string",
          "default": "**/{.git,.cache,node_modules,build,dist,out,research}/**",
          "description": "本地 C 索引扫描排除规则（VS Code glob）。修改后自动重新扫描，也可运行重建索引命令。"
        },
        "sourceInsightInspired.relationView": {
          "type": "string",
          "enum": [
            "horizontalGraph",
            "outline"
          ],
          "default": "horizontalGraph",
          "enumDescriptions": [
            "横向图：调用者 → 当前函数 → 调用函数，各一层",
            "原有树形列表：切换调用方向并逐级展开"
          ],
          "description": "Relation 的显示方式。横向图同时显示当前函数的直接调用者和直接调用函数；树形列表保留多级 Outline。"
        },
        "sourceInsightInspired.textLookupExclude": {
          "type": "string",
          "default": "**/{.git,.cache,node_modules,build,dist,out,research}/**",
          "description": "文件夹字符检索额外排除规则；同时遵循 files.exclude / search.exclude 中值为 true 的规则。"
        },
        "sourceInsightInspired.symbolHighlightUseF2": {
          "type": "boolean",
          "default": true,
          "description": "使用 F2 固定 / 取消同名符号高亮，覆盖 F2 原有重命名；关闭后保留 Ctrl+Alt+H 或命令入口。"
        }
      }
    },
    "keybindings": [
      {
        "command": "sourceInsightInspired.jumpToDefinition",
        "key": "alt+=",
        "when": "config.sourceInsightInspired.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightInspired.back",
        "key": "alt+,",
        "when": "config.sourceInsightInspired.sourceInsightKeys && (editorTextFocus || listFocus)"
      },
      {
        "command": "sourceInsightInspired.forward",
        "key": "alt+.",
        "when": "config.sourceInsightInspired.sourceInsightKeys && (editorTextFocus || listFocus)"
      },
      {
        "command": "sourceInsightInspired.lookupReferences",
        "key": "shift+f12",
        "when": "config.sourceInsightInspired.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightInspired.browseSymbols",
        "key": "alt+shift+s",
        "when": "config.sourceInsightInspired.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightInspired.findFile",
        "key": "alt+shift+p",
        "when": "config.sourceInsightInspired.sourceInsightKeys && editorTextFocus"
      },
      {
        "command": "sourceInsightInspired.nextReference",
        "key": "f8",
        "when": "config.sourceInsightInspired.sourceInsightKeys && (sourceInsightInspired.hasReferences || sourceInsightInspired.hasTextMatches) && editorTextFocus"
      },
      {
        "command": "sourceInsightInspired.previousReference",
        "key": "shift+f8",
        "when": "config.sourceInsightInspired.sourceInsightKeys && (sourceInsightInspired.hasReferences || sourceInsightInspired.hasTextMatches) && editorTextFocus"
      },
      {
        "command": "sourceInsightInspired.toggleSymbolHighlight",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      },
      {
        "command": "sourceInsightInspired.toggleSymbolHighlight",
        "key": "f2",
        "when": "editorTextFocus && config.sourceInsightInspired.symbolHighlightUseF2"
      }
    ],
    "themes": [
      {
        "id": "Source Insight Inspired Source Insight",
        "label": "Source Insight Inspired Source Insight",
        "uiTheme": "vs",
        "path": "./themes/source-insight-color-theme.json"
      }
    ],
    "colors": [
      {
        "id": "sourceInsightInspired.preview.keywordForeground",
        "description": "Source Insight Inspired Context keywordForeground",
        "defaults": {
          "dark": "symbolIcon.keywordForeground",
          "light": "symbolIcon.keywordForeground",
          "highContrast": "symbolIcon.keywordForeground",
          "highContrastLight": "symbolIcon.keywordForeground"
        }
      },
      {
        "id": "sourceInsightInspired.preview.controlForeground",
        "description": "Source Insight Inspired Context controlForeground",
        "defaults": {
          "dark": "symbolIcon.keywordForeground",
          "light": "symbolIcon.keywordForeground",
          "highContrast": "symbolIcon.keywordForeground",
          "highContrastLight": "symbolIcon.keywordForeground"
        }
      },
      {
        "id": "sourceInsightInspired.preview.typeForeground",
        "description": "Source Insight Inspired Context typeForeground",
        "defaults": {
          "dark": "symbolIcon.classForeground",
          "light": "symbolIcon.classForeground",
          "highContrast": "symbolIcon.classForeground",
          "highContrastLight": "symbolIcon.classForeground"
        }
      },
      {
        "id": "sourceInsightInspired.preview.functionForeground",
        "description": "Source Insight Inspired Context functionForeground",
        "defaults": {
          "dark": "symbolIcon.functionForeground",
          "light": "symbolIcon.functionForeground",
          "highContrast": "symbolIcon.functionForeground",
          "highContrastLight": "symbolIcon.functionForeground"
        }
      },
      {
        "id": "sourceInsightInspired.preview.stringForeground",
        "description": "Source Insight Inspired Context stringForeground",
        "defaults": {
          "dark": "debugTokenExpression.string",
          "light": "debugTokenExpression.string",
          "highContrast": "debugTokenExpression.string",
          "highContrastLight": "debugTokenExpression.string"
        }
      },
      {
        "id": "sourceInsightInspired.preview.stringBackground",
        "description": "Source Insight Inspired Context stringBackground",
        "defaults": {
          "dark": "#00000000",
          "light": "#00000000",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "sourceInsightInspired.preview.numberForeground",
        "description": "Source Insight Inspired Context numberForeground",
        "defaults": {
          "dark": "debugTokenExpression.number",
          "light": "debugTokenExpression.number",
          "highContrast": "debugTokenExpression.number",
          "highContrastLight": "debugTokenExpression.number"
        }
      },
      {
        "id": "sourceInsightInspired.preview.commentForeground",
        "description": "Source Insight Inspired Context commentForeground",
        "defaults": {
          "dark": "descriptionForeground",
          "light": "descriptionForeground",
          "highContrast": "descriptionForeground",
          "highContrastLight": "descriptionForeground"
        }
      },
      {
        "id": "sourceInsightInspired.preview.preprocessorForeground",
        "description": "Source Insight Inspired Context preprocessorForeground",
        "defaults": {
          "dark": "symbolIcon.keywordForeground",
